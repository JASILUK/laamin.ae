# Public site URL, used for canonical URLs, sitemap.xml and robots.txt.
# Set this to the production domain once it is confirmed (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enquiry form email delivery (server-side only — never prefix these with NEXT_PUBLIC_).
# Any SMTP provider works. For a Gmail / Google Workspace mailbox use
# smtp.gmail.com, port 465 and an App Password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where enquiries are delivered, and the address they are sent from.
ENQUIRY_TO_EMAIL=info.laamin@gmail.com
ENQUIRY_FROM_EMAIL=
